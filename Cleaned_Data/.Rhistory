risk.table = TRUE,
surv.median.line = "hv",
data = logChargeoff,
conf.int = TRUE,
palette = "Set1",
legend.title = "Application Code", )
library(dplyr)
#| label: censor extreme outliers
logChargeoff_clean = mutate(logChargeoff, Is_Censored_Clean = ifelse(Time_to_Charge_Off > 6000, 1, Is_Censored), Time_Clean = ifelse(Time_to_Charge_Off > 6000, 6000, Time_to_Charge_Off))
logChargeoff_clean
