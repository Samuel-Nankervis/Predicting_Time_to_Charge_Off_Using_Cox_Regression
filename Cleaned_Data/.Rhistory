evelyn = ""
# put your name here so it takes your working directory
wd = samuel
setwd(wd)
Chargeoff_Data = read.csv("Cleaned_Chargeoff_Data.csv")
# Chunk 2: convert data to numeric
#| label: convert data to numeric
head(Chargeoff_Data)
#numeric data is read as a string so we'll mutate it to make it numeric
Chargeoff_Data_Numeric = mutate(Chargeoff_Data, Effective_Annual_Interest_Rate = as.numeric(Effective_Annual_Interest_Rate), Effective_Monthly_Intrest_Rate = as.numeric(Effective_Monthly_Intrest_Rate), Time_To_Maturity = as.numeric(Time_To_Maturity), Time_to_Charge_Off = as.numeric(Time_to_Charge_Off), Original_Loan_Amount= as.numeric(Original_Loan_Amount), Monthly_Payment = as.numeric(Monthly_Payment), Total_Chargeoff = as.numeric(Total_Chargeoff), LTD_Recovery_Amount = as.numeric(LTD_Recovery_Amount), Is_Censored = as.numeric(Is_Censored))
# Chunk 3: summary of data
#| label: summary of data
summary(Chargeoff_Data_Numeric)
# Chunk 4: check how data is distribuited
#| label: check how data is distribuited
histogramMaker = function(values,x,y,title){
#makes a bar chart for the States
df = data.frame(values)
ggplot(df, aes(x = values)) +
geom_histogram(color = "black", fill = "steelblue") +
lims(x = c(min(values)-0.05, max(values)+0.05)) +
labs(x = x,
y = y,
title = title) +
theme(axis.title = element_text(size = 16),
axis.text = element_text(size = 12),
plot.title = element_text(size = 18, face = "bold"))
}
barchartMaker = function(data, x_var, fill_color = "steelblue", title = NULL) {
ggplot(data, aes(x = {{ x_var }})) +
geom_bar(fill = fill_color) +
labs(
title = title,
x = substitute(x_var),
y = "Count"
) +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1),
legend.position = "None")
}
histogramMaker(Chargeoff_Data_Numeric$Effective_Annual_Interest_Rate ,"Effective annual rate","Frequency","")
histogramMaker(Chargeoff_Data_Numeric$Time_To_Maturity ,"Time to Maturity","Frequency","")
histogramMaker(Chargeoff_Data_Numeric$Time_to_Charge_Off ,"Time_to_Charge_Off","Frequency","")
histogramMaker(Chargeoff_Data_Numeric$Monthly_Payment ,"Monthly Payment","Frequency","")
histogramMaker(Chargeoff_Data_Numeric$Original_Loan_Amount ,"Loan amount","Frequency","")
barchartMaker(Chargeoff_Data_Numeric, Is_Censored ,title = "Application codes")
barchartMaker(Chargeoff_Data_Numeric, Application_Code ,title = "Application codes")
barchartMaker(Chargeoff_Data_Numeric, Product ,title = "Types of loans")
# Chunk 5: check linearity
#| label: check linearity
chargeoffNoCategorical = select(Chargeoff_Data_Numeric, Effective_Annual_Interest_Rate, Monthly_Payment, Time_To_Maturity, Original_Loan_Amount, Time_to_Charge_Off)
ggpairs(chargeoffNoCategorical)
# Chunk 6: check log linearity
#| label: check log linearity
logChargeoff = mutate(Chargeoff_Data_Numeric, Monthly_Payment = log(Monthly_Payment), Original_Loan_Amount = log(Original_Loan_Amount), Effective_Annual_Interest_Rate = log(Effective_Annual_Interest_Rate))
chargeoffNoCategorical = select(logChargeoff, Effective_Annual_Interest_Rate, Monthly_Payment, Time_To_Maturity, Original_Loan_Amount, Time_to_Charge_Off)
ggpairs(chargeoffNoCategorical)
# Chunk 7: Cox regression model
#| label: Cox regression model
coxMod <- coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment + Time_To_Maturity + Original_Loan_Amount+ Application_Code, data = logChargeoff)
coxMod
# Chunk 8: Testing Proportional Hazards assumption
#| label: Testing Proportional Hazards assumption
testPH <- cox.zph(coxMod)
testPH # If p values are high, we can assume the proportional hazards assumption is met.
# Chunk 9: Stratified Cox regression model
#| label: Stratified Cox regression model
stratCoxMod <- coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment + Time_To_Maturity + Original_Loan_Amount + strata(Application_Code), data = logChargeoff)
stratCoxMod
testPH <- cox.zph(stratCoxMod)
testPH
# Chunk 10: Graph Cox regression model Schoenfeld residuals
#| label: Graph Cox regression model Schoenfeld residuals
ggcoxzph(testPH)
# Chunk 11: Graph Cox regression model influential obsrvations
#| label: Graph Cox regression model influential obsrvations
ggcoxdiagnostics(stratCoxMod, type = "dfbeta",
linear.predictions = FALSE, ggtheme = theme_bw())
ggcoxdiagnostics(stratCoxMod, type = "deviance",
linear.predictions = FALSE, ggtheme = theme_bw())
# Chunk 12: Graph Cox regression model linearity
#| label: Graph Cox regression model linearity
ggcoxfunctional(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment + Time_To_Maturity + Original_Loan_Amount, data = logChargeoff)
# Chunk 13: Cox regression model VIF
#| label: Cox regression model VIF
vif(stratCoxMod)
# Chunk 14: Cox regression model better VIF
#| label: Cox regression model better VIF
VifCoxMod = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment + strata(Application_Code), data = logChargeoff)
VifCoxMod
vif(VifCoxMod)
# Chunk 15: Testing assumptions for Vif model
#| label: Testing assumptions for Vif model
testPH = cox.zph(VifCoxMod)
testPH # If p values are high, we can assume the proportional hazards assumption is met.
ggcoxzph(testPH)
ggcoxdiagnostics(VifCoxMod, type = "dfbeta",
linear.predictions = FALSE, ggtheme = theme_bw())
ggcoxdiagnostics(VifCoxMod, type = "deviance",
linear.predictions = FALSE, ggtheme = theme_bw())
ggcoxfunctional(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment, data = logChargeoff)
# Chunk 16: Graph Cox regression model linearity Testing
#| label: Graph Cox regression model linearity Testing
# 1. Fit the model
res.cox = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + strata(Application_Code), data = logChargeoff)
# 2. Calculate Martingale residuals
mart_res <- residuals(res.cox, type = "martingale")
martChargeoff = mutate(logChargeoff, martRes = mart_res)
# 3. Plot residuals against the predictor
ggplot(martChargeoff, aes(x = Monthly_Payment, y = mart_res)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "loess") + # Adds a trend line
theme_minimal() +
labs(title = "Martingale Residuals vs Monthly_Payment",
y = "Martingale Residuals")
# 1. Fit the model
res.cox <- coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + strata(Application_Code), data = logChargeoff)
# 2. Calculate Martingale residuals
mart_res <- residuals(res.cox, type = "martingale")
martChargeoff = mutate(logChargeoff, martRes = mart_res)
# 3. Plot residuals against the predictor
ggplot(martChargeoff, aes(x = Effective_Annual_Interest_Rate, y = mart_res)) +
geom_point(alpha = 0.3) +
geom_smooth(method = "loess") + # Adds a trend line
theme_minimal() +
labs(title = "Martingale Residuals vs Effective_Annual_Interest_Rate",
y = "Martingale Residuals")
# Chunk 17: Cox regression by Application_Code
#| label: Cox regression by Application_Code
CCdata = filter(logChargeoff, Application_Code == "CC")
CRdata = filter(logChargeoff, Application_Code == "CR")
CIdata = filter(logChargeoff, Application_Code == "CI")
CC_CoxMod = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment, data = CCdata)
CC_CoxMod
CR_CoxMod = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment, data = CRdata)
CR_CoxMod
CI_CoxMod = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment, data = CIdata)
CI_CoxMod
# Chunk 18: survival curve
#| label: survival curve
FinalCoxMod = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment + strata(Application_Code), data = logChargeoff)
fit <- survfit(FinalCoxMod, data = logChargeoff)
ggsurvplot(fit,
risk.table = TRUE,
surv.median.line = "hv",
data = logChargeoff,
conf.int = TRUE,
palette = "Set1",
legend.title = "Application Code", )
# Chunk 19: censor extreme outliers and redo survival curve
#| label: censor extreme outliers and redo survival curve
logChargeoffClean = mutate(logChargeoff, Is_Censored = ifelse(Time_to_Charge_Off > 5500, 1, Is_Censored), Time_to_Charge_Off = ifelse(Time_to_Charge_Off > 5500, 5500, Time_to_Charge_Off))
FinalCoxMod = coxph(Surv(Time_to_Charge_Off, Is_Censored) ~ Effective_Annual_Interest_Rate + Monthly_Payment + strata(Application_Code), data = logChargeoffClean)
fit <- survfit(FinalCoxMod, data = logChargeoff)
ggsurvplot(fit,
risk.table = TRUE,
surv.median.line = "hv",
data = logChargeoff,
conf.int = TRUE,
palette = "Set1",
legend.title = "Application Code", )
