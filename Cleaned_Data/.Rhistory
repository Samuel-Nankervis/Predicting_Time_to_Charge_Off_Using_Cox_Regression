suppressPackageStartupMessages(library(math3190package))
suppressPackageStartupMessages(library(survival))
suppressPackageStartupMessages(library(survminer))
suppressPackageStartupMessages(library(GGally))
suppressPackageStartupMessages(library(car))
#note, this will need to be changed to your working directory here and also at the top of the quarto document if you want to use the working directory past this chunk.
#I set up variables so we only need to change one word to get it working after pulling it. put your working directory as a string here.
kay = "~/Documents/git_connect/Predicting_Time_to_Charge_Off_Using_Cox_Regression"
