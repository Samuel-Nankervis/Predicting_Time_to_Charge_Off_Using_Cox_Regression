# 1. Create the survfit object from your Cox model
fit <- survfit(FinalCoxMod, data = logChargeoff)
plot(fit)
# 2. Plot the survival curves
ggsurvplot(fit,
data = logChargeoff,
conf.int = TRUE,           # Add confidence intervals
palette = "Set1",          # Change colors
legend.title = "App Code", # Change legend title
ggtheme = theme_minimal()) # Use a clean theme
# 2. Plot the survival curves
ggsurvplot(fit,
data = logChargeoff,
conf.int = TRUE,           # Add confidence intervals
palette = "Set1",          # Change colors
legend.title = "Application Code", ) # Use a clean theme
ggsurvplot(fit,
data = logChargeoff,
fun = "pct",               # Convert Y-axis to percentage (0-100)
risk.table = TRUE,         # Add the 'Number at Risk' table below the plot
pval = TRUE,               # Show the p-value of the log-rank test
surv.median.line = "hv",   # Draw a line at the 50% survival mark
xlab = "Days",
ylab = "Probability of No Charge-Off",
title = "Survival Probability by Application Code")
ggsurvplot(fit,
fun = "pct",
data = logChargeoff,
conf.int = TRUE,
palette = "Set1",
legend.title = "Application Code", )
ggsurvplot(fit,
risk.table = TRUE,
data = logChargeoff,
conf.int = TRUE,
palette = "Set1",
legend.title = "Application Code", )
ggsurvplot(fit,
risk.table = TRUE,
pval = TRUE,
data = logChargeoff,
conf.int = TRUE,
palette = "Set1",
