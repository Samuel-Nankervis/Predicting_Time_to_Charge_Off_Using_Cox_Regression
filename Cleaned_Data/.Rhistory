# Create two hypothetical loans
new_profiles <- data.frame(
Effective_Annual_Interest_Rate = c(0.05, 0.25), # 5% vs 25%
Monthly_Payment = c(5.5, 5.5),                  # Held constant
Application_Code = c("CI", "CI")                # Compare within one code
)
# Generate curves for these specific profiles
fit_new <- survfit(FinalCoxMod, newdata = new_profiles)
# Plot them
ggsurvplot(fit_new, data = logChargeoff, legend.labs = c("5% Rate", "25% Rate"))
fit <- survfit(FinalCoxMod, data = logChargeoff)
